# Required
TELEGRAM_BOT_TOKEN=123456:replace-with-your-token
OPENAI_API_KEY=sk-replace-with-your-key

# Recommended security setup:
# 1. Run the bot.
# 2. Send /whoami to the bot from your Telegram account.
# 3. Put that numeric id here.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Alternative first-time setup:
# Leave TELEGRAM_ALLOWED_USER_IDS empty, set this to a long random value,
# then send /claim your-long-random-value to the bot.
BOT_SETUP_TOKEN=

# OpenAI
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_CHOICES=gpt-5.4-mini,gpt-5.4,gpt-5.5
OPENAI_BASE_URL=
OPENAI_STORE=false

# Local state
POCKET_CODEX_DATA_DIR=./data
POCKET_CODEX_PROJECTS_FILE=./config/projects.json
MAX_HISTORY_MESSAGES=24
TELEGRAM_HISTORY_ON_OPEN_MESSAGES=30
TELEGRAM_HISTORY_EXPORT_MAX_MESSAGES=1000

# Codex Desktop sync
CODEX_SYNC_ENABLED=true
CODEX_HOME=C:/Users/boji1/.codex

# Optional command execution
# Keep this false unless this is a private, allowlisted deployment.
POCKET_CODEX_COMMANDS_ENABLED=false
POCKET_CODEX_COMMAND_TIMEOUT_SECONDS=60
POCKET_CODEX_COMMAND_OUTPUT_MAX_CHARS=0
POCKET_CODEX_COMMAND_INLINE_MAX_CHARS=3500
POCKET_CODEX_COMMAND_TOOL_MAX_ROUNDS=16
