# Required
TELEGRAM_BOT_TOKEN=123456:replace-with-your-token
OPENAI_API_KEY=sk-replace-with-your-key

# Recommended security setup:
# 1. Run the bot.
# 2. Send /whoami to the bot from your Telegram account.
# 3. Put that numeric id here.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Alternative first-time setup:
# Leave TELEGRAM_ALLOWED_USER_IDS empty, set this to a long random value,
# then send /claim your-long-random-value to the bot.
BOT_SETUP_TOKEN=

# OpenAI
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STORE=false

# Local state
POCKET_CODEX_DATA_DIR=./data
POCKET_CODEX_PROJECTS_FILE=./config/projects.json
MAX_HISTORY_MESSAGES=24

# Codex Desktop sync
CODEX_SYNC_ENABLED=true
CODEX_HOME=C:/Users/boji1/.codex
